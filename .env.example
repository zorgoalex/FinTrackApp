VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Public HTTPS URL of the self-hosted GLM-OCR gateway. No secret belongs here.
VITE_RECEIPT_OCR_URL=https://ocr.your-domain.example

# WorkOS is connected as a Supabase OAuth provider so auth.users UUIDs and RLS stay intact.
# Enable only after configuring WorkOS in Supabase Auth and adding the OAuth callback in WorkOS.
VITE_WORKOS_AUTH_ENABLED=false
VITE_WORKOS_CONNECTION_ID=conn_YOUR_WORKOS_CONNECTION_ID
VITE_WEB_PUSH_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
# External STT is disabled for the zero-cost privacy-first beta.
VITE_EXTERNAL_STT_ENABLED=false
# Public support address shown in beta/privacy terms and deletion instructions.
VITE_SUPPORT_EMAIL=support@your-domain.example
# Public Cloudflare Turnstile site key. The private key must never use a VITE_ prefix.
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY

# Supabase Edge Function secrets (set with `supabase secrets set`, never expose as VITE_*).
# TURNSTILE_SECRET_KEY=YOUR_PRIVATE_CLOUDFLARE_TURNSTILE_SECRET_KEY
# OPENROUTER_MANAGEMENT_KEY=...
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=openrouter/free
# BETA_EXTERNAL_AI_ENABLED=false
# STT_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_STT_MODEL=whisper-large-v3
# STT_TIMEOUT_MS=45000
# STT_MAX_FILE_BYTES=18874368
# STT_PROMPT=Финансовая операция на русском языке. Суммы, тенге, KZT, категории и счета.
# BETA_EXTERNAL_STT_ENABLED=false
# AI_MONITOR_CRON_SECRET=...
# AI_ADMIN_ALERT_EMAILS=admin@example.com
# RESEND_API_KEY=...
# ALERT_FROM_EMAIL=FinTrackApp <alerts@your-domain.example>
# INVITATION_FROM_EMAIL=invite@your-domain.example
# EMAIL_FROM_NAME=FinTrackApp
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@your-domain.example
# NOTIFICATION_FROM_EMAIL=FinTrackApp <notifications@your-domain.example>
