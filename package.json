{
  "name": "fintrackapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "verify": "npm run lint && npm test && npm run build",
    "verify:release": "npm run verify && npm run test:sql",
    "hooks:install": "git config core.hooksPath .githooks",
    "benchmark:receipts": "node scripts/receipt-ocr-benchmark.mjs",
    "security:test:stage-2-1": "node scripts/run-security-stage-2-1.mjs",
    "security:test:stage-2-1:http": "node scripts/security-stage-2-1-http.mjs",
    "security:test:stage-2-2": "node scripts/run-security-stage-2-2.mjs",
    "supabase:init": "npx supabase init",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:reset": "npx supabase db reset",
    "security:test:browser": "node scripts/run-security-browser-e2e.mjs",
    "security:test:browser:list": "node scripts/run-security-browser-e2e.mjs --list",
    "security:test:browser:sequential": "node scripts/run-security-browser-e2e.mjs --grep @sequential",
    "security:test:browser:concurrent": "node scripts/run-security-browser-e2e.mjs --grep @concurrent",
    "pilot:baseline": "node scripts/stage-4-2-pilot-baseline.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.0.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.32",
    "supabase": "^2.33.9",
    "tailwindcss": "^3.3.6",
    "vite": "^8.2.0"
  }
}
